# Variables de entorno — copia este archivo como .env y rellena tus keys

# ==================== NASA ====================
# Obtén tu key gratis en: https://api.nasa.gov/
NASA_API_KEY=DEMO_KEY

# ==================== NOAA ====================
# Sin key — datos públicos gratuitos
NOAA_BASE_URL=https://services.swpc.noaa.gov

# ==================== Helioviewer ====================
# Sin key — API pública gratuita
HELIOVIEWER_URL=https://api.helioviewer.org/v2

# ==================== Base de datos ====================
DATABASE_URL=postgresql+asyncpg://heliox:heliox123@localhost:5432/heliox_db

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== App ====================
APP_NAME=HELIOX
APP_AUTHOR=JESUS BARRIOS
APP_VERSION=1.0.0
APP_ENV=development
SECRET_KEY=cambia_esto_por_una_clave_segura_larga

# ==================== CORS ====================
ALLOWED_ORIGINS=http://localhost:3000,https://heliox.jesusbarrios.co

# ==================== Celery ====================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==================== Monetización & Ads ====================
ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXXX

# ==================== Cuentas Bancarias y Pasarelas (JESÚS BARRIOS) ====================
# 1. Nequi y Daviplata (Colombia)
NEQUI_NUMBER=3001234567
DAVIPLATA_NUMBER=3001234567

# 2. Cuenta Bancaria (Transferencia Bancolombia / Davivienda / PSE)
BANK_NAME=Bancolombia
BANK_ACCOUNT_TYPE=Ahorros
BANK_ACCOUNT_NUMBER=123-456789-00
ACCOUNT_HOLDER_NAME=JESUS BARRIOS
ACCOUNT_HOLDER_DOC=C.C. 1234567890

# 3. PayPal (Internacional)
PAYPAL_ME_URL=https://paypal.me/jesusbarrios
PAYPAL_CLIENT_ID=sb

# 4. Wompi (Bancolombia - Tarjetas Débito/Crédito + PSE + Nequi automático)
# Obtén tu llave pública en: https://wompi.co/
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXX

# 5. Stripe (Tarjetas internacionales)
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXX
